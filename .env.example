# Vercel이 아닌 곳에 배포할 때만 설정하면 됩니다.
# 설정하지 않으면 루트 레이아웃의 metadataBase가 http://localhost:3000으로 고정됩니다.
# (참고: /c/[slug] 페이지의 OG 태그는 요청 Host 헤더를 별도로 사용하므로 이 값과 무관하게 정확합니다.)
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example.com

# ── 로그인·권한 (서버에서만 사용, 절대 NEXT_PUBLIC_ 로 시작하게 만들지 마세요) ──
# 세션 쿠키 서명 키: 16자 이상 임의 문자열. 없으면 로그인 API가 동작하지 않습니다.
#   생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# 관리자(서비스전략팀) 로그인 비밀번호. 비어 있으면 관리자 로그인이 비활성화됩니다.
# 이 값은 담당자가 직접 정해 로컬 .env.local 과 배포 환경 변수에만 넣고, 저장소에는 커밋하지 않습니다.
ADMIN_PASSWORD=
# 관리자 1명의 사번과 이름(소스코드에는 적지 않고 서버 설정에만 둡니다). 비밀번호와 함께 셋 중 하나라도 비면 관리자 로그인은 꺼집니다.
ADMIN_EMPLOYEE_ID=
ADMIN_NAME=

# (선택) 서버 데이터(직원 로그인 기록, 내 보관함, 활용 이력, 공지)를 저장할 폴더. 비워두면 프로젝트의 .data/ 에 저장됩니다.
# Vercel처럼 파일이 영구 보관되지 않는 환경에서는 데이터가 사라질 수 있으므로, 운영 전에는 DB로 교체해야 합니다.
APP_DATA_DIR=

# (HY AGENT PLACE 등 하위 경로 배포용) 앱이 서비스되는 주소의 앞부분. 예: /apps/앱이름
# 플랫폼이 컨테이너 시작 때 자동으로 넣어 주므로 포털에서 직접 입력하지 않습니다. 로컬 개발에서는 비워 둡니다.
# 도커 이미지는 빌드할 때 /__APP_BASE_PATH__ 자리표시로 만들고, 시작 스크립트(scripts/docker-start.sh)가 이 값으로 바꿉니다.
# 자세한 내용: docs/deployment/HY_AGENT_PLACE_DEPLOYMENT.md
APP_BASE_PATH=
